# Environment Configuration — WorkPilot AI
# Copy this file to .env for local development.

# PostgreSQL Connection String
# For local Docker Compose setup: postgresql://workpilot:workpilot_pass@localhost:5432/workpilot_db?schema=public
DATABASE_URL="postgresql://workpilot:workpilot_pass@localhost:5432/workpilot_db?schema=public"

# OpenAI API Key (required for interpretation & planning)
OPENAI_API_KEY="your-openai-api-key-here"

# Application Settings
NODE_ENV="development"
PORT="3000"
