// Prisma Schema — WorkPilot AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal placeholder model for Phase 1 foundation verification
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  status    String   @default("ok")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum WorkRequestStatus {
  RECEIVED
  INTERPRETED
  PLANNED
  IN_PROGRESS
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  NEEDS_CLARIFICATION
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionItemStatus {
  PENDING
  PLANNED
  IN_PROGRESS
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  REJECTED
  BLOCKED
  NEEDS_CLARIFICATION
}

enum ExecutionRoute {
  EXECUTE_AUTOMATICALLY
  PREPARE_FOR_HUMAN_REVIEW
  CANNOT_EXECUTE
  REQUIRES_CLARIFICATION
}

enum ExecutionStepStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  REJECTED
  SKIPPED
}

enum ToolExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArtifactType {
  COMMUNICATION_DRAFT
  MARKDOWN_BRIEF
  WEBSITE_REPORT
  TASK_RECORD
  OTHER
}

enum ActivityEventType {
  REQUEST_RECEIVED
  INTERPRETATION_STARTED
  INTERPRETATION_COMPLETED
  INTERPRETATION_FAILED
  PLAN_CREATED
  ACTION_STARTED
  TOOL_STARTED
  TOOL_SUCCEEDED
  TOOL_FAILED
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  ACTION_COMPLETED
  ACTION_FAILED
  CLARIFICATION_REQUIRED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model WorkRequest {
  id           String            @id @default(uuid())
  originalText String            @db.Text
  status       WorkRequestStatus @default(RECEIVED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  interpretation Interpretation?
  actionItems    ActionItem[]
  executionPlan  ExecutionPlan?
  toolExecutions ToolExecution[]
  approvals      Approval[]
  artifacts      Artifact[]
  activityEvents ActivityEvent[]

  @@index([status])
  @@index([createdAt])
}

model Interpretation {
  id                    String        @id @default(uuid())
  workRequestId         String        @unique
  workRequest           WorkRequest   @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  title                 String
  summary               String        @db.Text
  priority              PriorityLevel @default(MEDIUM)
  detectedDeadline      DateTime?
  missingInformation    Json?
  automatableActions    Json?
  humanConfirmationReqs Json?
  createdAt             DateTime      @default(now())
}

model ActionItem {
  id            String           @id @default(uuid())
  workRequestId String
  workRequest   WorkRequest      @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  description   String           @db.Text
  status        ActionItemStatus @default(PENDING)
  priority      PriorityLevel?
  dueAt         DateTime?
  actionType    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  executionSteps ExecutionStep[]

  @@index([workRequestId])
  @@index([status])
}

model ExecutionPlan {
  id            String        @id @default(uuid())
  workRequestId String        @unique
  workRequest   WorkRequest   @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  steps ExecutionStep[]
}

model ExecutionStep {
  id              String              @id @default(uuid())
  executionPlanId String
  executionPlan   ExecutionPlan       @relation(fields: [executionPlanId], references: [id], onDelete: Cascade)
  actionItemId    String?
  actionItem      ActionItem?         @relation(fields: [actionItemId], references: [id], onDelete: SetNull)
  route           ExecutionRoute
  reason          String              @db.Text
  status          ExecutionStepStatus @default(PENDING)
  toolName        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  toolExecutions ToolExecution[]
  approvals      Approval[]
  artifacts      Artifact[]

  @@index([executionPlanId])
  @@index([status])
  @@index([actionItemId])
}

model ToolExecution {
  id              String              @id @default(uuid())
  workRequestId   String
  workRequest     WorkRequest         @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  executionStepId String?
  executionStep   ExecutionStep?      @relation(fields: [executionStepId], references: [id], onDelete: SetNull)
  toolName        String
  status          ToolExecutionStatus @default(PENDING)
  input           Json?
  output          Json?
  error           String?             @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())

  @@index([workRequestId])
  @@index([executionStepId])
  @@index([status])
}

model Approval {
  id              String         @id @default(uuid())
  workRequestId   String
  workRequest     WorkRequest    @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  executionStepId String
  executionStep   ExecutionStep  @relation(fields: [executionStepId], references: [id], onDelete: Cascade)
  status          ApprovalStatus @default(PENDING)
  originalContent String?        @db.Text
  editedContent   String?        @db.Text
  reviewerNote    String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  resolvedAt      DateTime?

  @@index([workRequestId])
  @@index([executionStepId])
  @@index([status])
}

model Artifact {
  id              String         @id @default(uuid())
  workRequestId   String
  workRequest     WorkRequest    @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  executionStepId String?
  executionStep   ExecutionStep? @relation(fields: [executionStepId], references: [id], onDelete: SetNull)
  type            ArtifactType
  title           String
  content         String         @db.Text
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([workRequestId])
  @@index([type])
}

model ActivityEvent {
  id            String            @id @default(uuid())
  workRequestId String
  workRequest   WorkRequest       @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  type          ActivityEventType
  message       String            @db.Text
  metadata      Json?
  timestamp     DateTime          @default(now())

  @@index([workRequestId, timestamp])
}
